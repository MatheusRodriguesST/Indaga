# Copie para .env.local e preencha.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (service_role). Só é usada no servidor — NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrador ---
# Senha do painel /admin (mínimo 12 caracteres). Gere com: openssl rand -base64 24
ADMIN_SECRET=

# --- App ---
# URL pública (usada no QR Code, sitemap e imagens de compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Perguntas por desafio (padrão 5)
NEXT_PUBLIC_QUIZ_SIZE=5

# Só para demonstração em produção SEM banco (dados somem a cada deploy).
# ALLOW_MEMORY_MODE=true
